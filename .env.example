# Defaults to a private embedded PostgreSQL database when DATABASE_URL is blank.
# DATABASE_URL=postgresql://...
# PGLITE_DIR=.data/eleganza
# APP_ORIGIN=http://127.0.0.1:3218

# Local preview staff only. Use distinct randomly generated keys.
PREVIEW_SESSION_SECRET=
PREVIEW_OWNER_KEY=
PREVIEW_CATALOG_KEY=
PREVIEW_OPERATIONS_KEY=
PREVIEW_SUPPORT_KEY=
PREVIEW_ANALYST_KEY=

# Optional business-managed Google IAP identity. Disables local access keys.
# IAP_AUDIENCE=/projects/PROJECT_NUMBER/global/backendServices/SERVICE_ID
# IAP_STAFF_JSON={"accounts.google.com:SUBJECT":"owner"}

# Optional Stripe sandbox. Live credentials are rejected.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
